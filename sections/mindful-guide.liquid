          {%- when 'spacer' -%}
            <div class="mgw__block mgw__spacer--{{ block.settings.height | default: 'md' }}" {{ block.shopify_attributes }} aria-hidden="true"></div>

          {%- when 'nav_card' -%}
            <div class="mgw__block mgw__nav-card mgw__nav-card--{{ block.settings.variant | default: 'continue' }}" {{ block.shopify_attributes }} {{ motion_attr }}>
              {%- if block.settings.title != blank -%}<h2 class="mgw__nav-card__title">{{ block.settings.title }}</h2>{%- endif -%}
              {%- if block.settings.body != blank -%}<div class="mgw__nav-card__body">{{ block.settings.body }}</div>{%- endif -%}
              {%- if block.settings.primary_label != blank or block.settings.secondary_label != blank -%}
                <div class="mgw__nav-card__actions">
                  {%- if block.settings.primary_label != blank -%}<a href="{{ block.settings.primary_link }}" class="mgw__btn mgw__btn--primary">{{ block.settings.primary_label }}</a>{%- endif -%}
                  {%- if block.settings.secondary_label != blank -%}<a href="{{ block.settings.secondary_link }}" class="mgw__btn mgw__btn--secondary">{{ block.settings.secondary_label }}</a>{%- endif -%}
                </div>
              {%- endif -%}
              {%- if block.settings.micro_text != blank -%}<p class="mgw__nav-card__micro">{{ block.settings.micro_text }}</p>{%- endif -%}
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>

  </div>
</section>

<script src="{{ 'mindful-guide.js' | asset_url }}" defer></script>

