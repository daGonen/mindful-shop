{%- comment -%}
  Section: Mindful Guide
  A modular, reusable section for structured weekly guide content.
  All content is configurable via Theme Editor settings and blocks.

  Assets required (place in theme assets/ folder):
    - mindful-guide.css
    - mindful-guide.js
{%- endcomment -%}

{%- liquid
  assign section_id = 'mgw-' | append: section.id
  assign max_width = section.settings.max_width | default: 'normal'
  assign spacing = section.settings.vertical_spacing | default: 'normal'
  assign bg_color = section.settings.background_color
  assign bg_texture = section.settings.background_texture
  assign texture_opacity = section.settings.texture_opacity | default: 15
  assign accent_color = section.settings.accent_color
  assign warm_accent = section.settings.warm_accent_color
  assign heading_scale = section.settings.heading_size_scale | default: 'normal'
  assign body_scale = section.settings.body_size_scale | default: 'normal'
  assign line_height_scale = section.settings.line_height_scale | default: 'normal'
  assign serif_headings = section.settings.serif_headings
  assign card_radius = section.settings.card_border_radius | default: 12
  assign card_padding = section.settings.card_padding | default: 24
  assign enable_motion = section.settings.enable_motion
  assign motion_style = section.settings.motion_style | default: 'fade'
  assign motion_speed = section.settings.motion_speed | default: 'normal'
  assign show_progress = section.settings.show_progress_bar
  assign show_print = section.settings.show_print_button
  assign show_pdf = section.settings.show_pdf_button
  assign pdf_url = section.settings.pdf_url
  assign hub_url = section.settings.hub_url
  assign help_email = section.settings.help_email
  assign show_hero = section.settings.show_hero
-%}

{{ 'mindful-guide.css' | asset_url | stylesheet_tag }}

<style>
  #{{ section_id }}.mgw {
    --mgw-accent: {{ accent_color | default: '#6b8f71' }};
    --mgw-warm: {{ warm_accent | default: '#c9a96e' }};
    --mgw-bg: {{ bg_color | default: '#ffffff' }};
    --mgw-text: #2c2c2c;
    --mgw-text-muted: #6b6b6b;
    --mgw-border: #e8e4df;
    --mgw-card-bg: #ffffff;
    --mgw-card-shadow: 0 1px 3px rgba(0,0,0,0.04), 0 4px 12px rgba(0,0,0,0.03);
    --mgw-radius: {{ card_radius }}px;
    --mgw-card-pad: {{ card_padding }}px;
    {% case spacing %}
      {% when 'tight' %}
        --mgw-space-xs: 8px; --mgw-space-sm: 12px; --mgw-space-md: 20px; --mgw-space-lg: 32px; --mgw-space-xl: 48px; --mgw-section-pad: 40px 0;
      {% when 'airy' %}
        --mgw-space-xs: 16px; --mgw-space-sm: 24px; --mgw-space-md: 40px; --mgw-space-lg: 56px; --mgw-space-xl: 80px; --mgw-section-pad: 80px 0;
      {% else %}
        --mgw-space-xs: 12px; --mgw-space-sm: 16px; --mgw-space-md: 28px; --mgw-space-lg: 44px; --mgw-space-xl: 64px; --mgw-section-pad: 60px 0;
    {% endcase %}
    {% case heading_scale %}
      {% when 'small' %} --mgw-h1: 2.5rem; --mgw-h2: 1.85rem; --mgw-h3: 1.5rem;
      {% when 'large' %} --mgw-h1: 3.5rem; --mgw-h2: 2.5rem; --mgw-h3: 1.95rem;
      {% else %} --mgw-h1: 3rem; --mgw-h2: 2.15rem; --mgw-h3: 1.7rem;
    {% endcase %}
    {% case body_scale %}
      {% when 'small' %} --mgw-body: 1.2rem; --mgw-small: 1rem;
      {% when 'large' %} --mgw-body: 1.6rem; --mgw-small: 1.3rem;
      {% else %} --mgw-body: 1.4rem; --mgw-small: 1.15rem;
    {% endcase %}
    {% case line_height_scale %}
      {% when 'tight' %} --mgw-lh: 1.5; --mgw-lh-heading: 1.2;
      {% when 'loose' %} --mgw-lh: 1.9; --mgw-lh-heading: 1.35;
      {% else %} --mgw-lh: 1.7; --mgw-lh-heading: 1.25;
    {% endcase %}
    {% case max_width %}
      {% when 'narrow' %} --mgw-max-width: 680px;
      {% when 'wide' %} --mgw-max-width: 1080px;
      {% else %} --mgw-max-width: 860px;
    {% endcase %}
    --mgw-texture-opacity: {{ texture_opacity | divided_by: 100.0 }};
    {% case motion_speed %}
      {% when 'fast' %} --mgw-motion-duration: 0.35s;
      {% when 'slow' %} --mgw-motion-duration: 0.8s;
      {% else %} --mgw-motion-duration: 0.55s;
    {% endcase %}
  }
</style>

{%- if show_progress -%}
<div class="mgw__progress" aria-hidden="true" id="{{ section_id }}-progress"></div>
{%- endif -%}

<section
  id="{{ section_id }}"
  class="mgw{% if serif_headings %} mgw--serif-headings{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="mindful-guide"
  {% if enable_motion and motion_style != 'none' %}data-motion-enabled="true" data-motion="{{ motion_style }}"{% else %}data-motion-enabled="false"{% endif %}
  {% if show_progress %}data-progress-bar="true" data-progress-id="{{ section_id }}-progress"{% endif %}
>

  {%- if show_progress -%}
    <div class="mgw__progress" aria-hidden="true" id="{{ section_id }}-progress"></div>
  {%- endif -%}

  {%- if bg_texture != blank -%}
    <div class="mgw__texture" aria-hidden="true" style="background-image: url('{{ bg_texture | image_url: width: 1920 }}');"></div>
  {%- endif -%}

  <div class="mgw__container">

    {%- if show_print or show_pdf or hub_url != blank or help_email != blank -%}
      <div class="mgw__toolbar">
        {%- if hub_url != blank -%}
          <a href="{{ hub_url }}" class="mgw__toolbar-btn">
            <svg viewBox="0 0 24 24"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1"/></svg>
            {{ section.settings.hub_label | default: 'Hub' }}
          </a>
        {%- endif -%}
        {%- if show_print -%}
          <button type="button" class="mgw__toolbar-btn" onclick="window.print()">
            <svg viewBox="0 0 24 24"><path d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2m-12 0h12v4H6v-4z"/></svg>
            {{ section.settings.print_label | default: 'Print' }}
          </button>
        {%- endif -%}
        {%- if show_pdf and pdf_url != blank -%}
          <a href="{{ pdf_url }}" class="mgw__toolbar-btn" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24"><path d="M12 10v6m0 0l-3-3m3 3l3-3M3 17v3a2 2 0 002 2h14a2 2 0 002-2v-3"/></svg>
            {{ section.settings.pdf_label | default: 'PDF' }}
          </a>
        {%- endif -%}
        {%- if help_email != blank -%}
          <a href="mailto:{{ help_email }}" class="mgw__toolbar-btn">
            <svg viewBox="0 0 24 24"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            {{ section.settings.help_label | default: 'Help' }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if show_hero -%}
      <header class="mgw__hero">
        {%- if section.settings.eyebrow != blank -%}
          <span class="mgw__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.hero_title != blank -%}
          <h1 class="mgw__hero-title">{{ section.settings.hero_title }}</h1>
        {%- endif -%}
        {%- if section.settings.hero_subtitle != blank -%}
          <p class="mgw__hero-subtitle">{{ section.settings.hero_subtitle }}</p>
        {%- endif -%}
        {%- if section.settings.hero_meta != blank -%}
          <p class="mgw__hero-meta">{{ section.settings.hero_meta }}</p>
        {%- endif -%}
        {%- if section.settings.hero_image != blank -%}
          <div class="mgw__hero-image">
            <img
              src="{{ section.settings.hero_image | image_url: width: 1200 }}"
              alt="{{ section.settings.hero_image.alt | escape }}"
              width="{{ section.settings.hero_image.width }}"
              height="{{ section.settings.hero_image.height }}"
              loading="lazy"
            >
          </div>
        {%- endif -%}
        {%- if section.settings.primary_btn_label != blank or section.settings.secondary_btn_label != blank -%}
          <div class="mgw__hero-actions">
            {%- if section.settings.primary_btn_label != blank -%}
              <a href="{{ section.settings.primary_btn_link }}" class="mgw__btn mgw__btn--primary">{{ section.settings.primary_btn_label }}</a>
            {%- endif -%}
            {%- if section.settings.secondary_btn_label != blank -%}
              <a href="{{ section.settings.secondary_btn_link }}" class="mgw__btn mgw__btn--secondary">{{ section.settings.secondary_btn_label }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="mgw__blocks">
      {%- for block in section.blocks -%}
        {%- liquid
          assign motion_attr = ''
          if enable_motion and motion_style != 'none'
            assign motion_attr = ' data-motion="' | append: motion_style | append: '"'
          endif
        -%}

        {%- case block.type -%}

          {%- when 'rich_text' -%}
            <div class="mgw__block mgw__rich-text mgw__rich-text--{{ block.settings.style | default: 'plain' }}{% if block.settings.bg_tint %} mgw__rich-text--tinted{% endif %}" {{ block.shopify_attributes }} {{ motion_attr }}>
              {%- if block.settings.title != blank -%}<h2 class="mgw__rich-text__title">{{ block.settings.title }}</h2>{%- endif -%}
              {%- if block.settings.body != blank -%}<div class="mgw__rich-text__body">{{ block.settings.body }}</div>{%- endif -%}
            </div>
            {%- if block.settings.show_divider -%}<div class="mgw__block-divider" aria-hidden="true"><svg class="mgw__block-divider-svg" viewBox="0 0 577 77" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet"><g transform="translate(0,77) scale(0.1,-0.1)" fill="currentColor" stroke="none"><path d="M4888 759 c-60 -9 -144 -55 -174 -94 -76 -100 -79 -248 -6 -318 32-30 101 -57 146 -57 73 1 167 73 165 128 0 25 -1 26 -12 7 -55 -90 -156 -116 -239 -61 -87 57 -68 222 33 296 75 54 204 64 287 21 52 -26 99 -82 108 -126 24 -128 -90 -316 -234 -387 -59 -29 -76 -33 -147 -32 -131 1 -267 65 -429 201 -43 36 -80 62 -83 59 -20 -20 169 -193 270 -246 129 -70 300 -108 433 -96 78 6 168 25 160 33 -3 3 -63 5 -133 4 l-128 -1 53 29 c104 58 171 133 234 259 35 70 42 92 42 145 1 162 -153 267 -346 236z"/><path d="M2573 600 c-29 -10 -79 -57 -69 -67 2 -3 17 5 33 17 62 46 167 22 331 -74 56 -33 83 -55 92 -76 12 -29 9 -104 -5 -149 -6 -18 -5 -23 6 -19 25 8 50 70 47 116 -3 34 0 41 12 36 109 -44 166 -52 280 -39 64 7 66 6 119 -29 57 -39 67 -40 56 -6 -8 25 -61 60 -91 60 -33 0 -35 10 -9 45 14 17 28 47 31 66 l6 34 -30 -47 c-82 -126 -208 -118 -448 27 -150 92 -280 129 -361 105z"/><path d="M930 559 c-133 -23 -268 -124 -324 -242 -45 -96 -32 -187 28 -203 36 -9 103 14 125 43 26 32 26 38 1 63 -21 21 -80 28 -80 10 0 -5 7 -10 16 -10 27 0 54 -20 48 -35 -7 -18 -75 -38 -98 -29 -43 16 4 170 66 217 93 72 225 107 413 112 159 5 236 -8 349 -57 67 -29 192 -51 171 -31 -15 15 -320 128 -395 147 -82 20 -248 28 -320 15z m96 -27 c-2 -4 -19 -9 -38 -10 -41 -3 -133 -29 -170 -48 -41 -21 -34 -8 10 21 21 14 59 29 83 34 57 11 121 13 115 3z"/><path d="M5316 524 c-18 -18 -6 -54 19 -54 7 0 15 -10 17 -21 5 -35 33 -47 58 -24 29 26 23 59 -12 63 -19 2 -28 9 -28 22 0 10 -7 21 -16 24 -21 8 -20 8 -38 -10z"/><path d="M144 510 c-142 -46 -189 -187 -95 -281 111 -112 282 -20 241 130 -18 68 -67 88 -127 51 -35 -21 -46 -48 -15 -35 9 5 31 10 49 13 39 5 58 -24 50 -76 -12 -68 -74 -99 -139 -68 -44 21 -68 63 -68 119 0 97 115 152 245 116 51 -14 125 -89 144 -147 21 -64 35 -65 28 -3 -19 157 -152 234 -313 181z"/><path d="M2587 523 c-3 -5 -8 -22 -11 -40 -6 -25 -3 -36 13 -52 12 -12 29 -21 40 -21 42 0 59 64 26 100 -18 20 -60 27 -68 13z"/><path d="M4464 519 c-12 -4 -29 -18 -38 -31 -36 -51 -7 -98 62 -98 32 0 45 6 61 26 26 33 26 55 4 83 -21 23 -58 32 -89 20z m81 -49 c0 -16 -63 -62 -79 -57 -24 8 -17 46 11 61 33 19 68 17 68 -4z"/><path d="M3212 508 c-26 -26 -6 -68 33 -68 25 0 48 35 40 61 -7 22 -54 26 -73 7z m45 -34 c-9 -9 -28 6 -21 18 4 6 10 6 17 -1 6 -6 8 -13 4 -17z"/><path d="M1932 429 c-57 -28 -122 -91 -122 -118 0 -17 6 -14 57 26 61 46 144 84 197 90 54 7 95 -12 176 -77 80 -65 136 -91 209 -97 47 -4 61 -1 90 19 49 33 51 49 4 32 -21 -7 -46 -13 -56 -14 -34 0 -129 40 -200 85 -138 88 -252 106 -355 54z"/><path d="M1115 417 c-21 -16 -14 -64 12 -74 42 -16 66 47 27 73 -17 12 -23 12 -39 1z"/><path d="M2487 423 c-10 -9 -8 -35 2 -52 13 -21 51 -4 51 24 0 27 -35 46 -53 28z"/><path d="M5450 399 c-71 -22 -126 -82 -149 -164 -16 -60 -1 -62 31 -4 16 29 38 64 50 76 103 110 373 27 355 -109 -10 -75 -83 -148 -147 -148 -84 0 -152 120 -105 187 19 27 64 43 93 32 35 -13 38 -37 8 -60 -49 -39 -14 -99 38 -66 21 14 26 25 26 58 0 82 -89 126 -170 84 -101 -52 -66 -229 53 -274 98 -37 215 45 233 164 16 108 -93 215 -234 229 -26 3 -63 0 -82 -5z"/><path d="M3938 371 c-32 -11 -79 -33 -105 -49 -119 -76 -209 -102 -268 -78 -43 18 -55 15 -34 -10 21 -25 73 -44 121 -44 53 0 143 41 214 97 70 56 106 73 156 73 51 0 141 -40 211 -94 52 -40 57 -42 57 -23 0 26 -70 95 -122 121 -63 32 -145 34 -230 7z"/><path d="M2055 330 c-56 -21 -77 -97 -34 -121 32 -17 88 -13 110 7 53 48 -8 139 -76 114z m70 -54 c0 -10 -16 -27 -38 -40 -31 -17 -39 -19 -46 -7 -13 20 -3 39 28 56 33 18 56 15 56 -9z"/></g></svg></div>{%- endif -%}

          {%- when 'bullet_list' -%}
            <div class="mgw__block mgw__bullet-list" {{ block.shopify_attributes }} {{ motion_attr }}>
              {%- if block.settings.title != blank -%}<h3 class="mgw__bullet-list__title">{{ block.settings.title }}</h3>{%- endif -%}
              {%- if block.settings.intro != blank -%}<p class="mgw__bullet-list__intro">{{ block.settings.intro }}</p>{%- endif -%}
              <ul class="mgw__list mgw__list--{{ block.settings.list_style | default: 'dot' }}{% if block.settings.two_column %} mgw__list--two-col{% endif %}">
                {%- if block.settings.item_1 != blank -%}<li>{{ block.settings.item_1 }}</li>{%- endif -%}
                {%- if block.settings.item_2 != blank -%}<li>{{ block.settings.item_2 }}</li>{%- endif -%}
                {%- if block.settings.item_3 != blank -%}<li>{{ block.settings.item_3 }}</li>{%- endif -%}
                {%- if block.settings.item_4 != blank -%}<li>{{ block.settings.item_4 }}</li>{%- endif -%}
                {%- if block.settings.item_5 != blank -%}<li>{{ block.settings.item_5 }}</li>{%- endif -%}
                {%- if block.settings.item_6 != blank -%}<li>{{ block.settings.item_6 }}</li>{%- endif -%}
                {%- if block.settings.item_7 != blank -%}<li>{{ block.settings.item_7 }}</li>{%- endif -%}
                {%- if block.settings.item_8 != blank -%}<li>{{ block.settings.item_8 }}</li>{%- endif -%}
                {%- if block.settings.item_9 != blank -%}<li>{{ block.settings.item_9 }}</li>{%- endif -%}
                {%- if block.settings.item_10 != blank -%}<li>{{ block.settings.item_10 }}</li>{%- endif -%}
              </ul>
            </div>
            {%- if block.settings.show_divider -%}<div class="mgw__block-divider" aria-hidden="true"><svg class="mgw__block-divider-svg" viewBox="0 0 577 77" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet"><g transform="translate(0,77) scale(0.1,-0.1)" fill="currentColor" stroke="none"><path d="M4888 759 c-60 -9 -144 -55 -174 -94 -76 -100 -79 -248 -6 -318 32-30 101 -57 146 -57 73 1 167 73 165 128 0 25 -1 26 -12 7 -55 -90 -156 -116 -239 -61 -87 57 -68 222 33 296 75 54 204 64 287 21 52 -26 99 -82 108 -126 24 -128 -90 -316 -234 -387 -59 -29 -76 -33 -147 -32 -131 1 -267 65 -429 201 -43 36 -80 62 -83 59 -20 -20 169 -193 270 -246 129 -70 300 -108 433 -96 78 6 168 25 160 33 -3 3 -63 5 -133 4 l-128 -1 53 29 c104 58 171 133 234 259 35 70 42 92 42 145 1 162 -153 267 -346 236z"/><path d="M2573 600 c-29 -10 -79 -57 -69 -67 2 -3 17 5 33 17 62 46 167 22 331 -74 56 -33 83 -55 92 -76 12 -29 9 -104 -5 -149 -6 -18 -5 -23 6 -19 25 8 50 70 47 116 -3 34 0 41 12 36 109 -44 166 -52 280 -39 64 7 66 6 119 -29 57 -39 67 -40 56 -6 -8 25 -61 60 -91 60 -33 0 -35 10 -9 45 14 17 28 47 31 66 l6 34 -30 -47 c-82 -126 -208 -118 -448 27 -150 92 -280 129 -361 105z"/><path d="M930 559 c-133 -23 -268 -124 -324 -242 -45 -96 -32 -187 28 -203 36 -9 103 14 125 43 26 32 26 38 1 63 -21 21 -80 28 -80 10 0 -5 7 -10 16 -10 27 0 54 -20 48 -35 -7 -18 -75 -38 -98 -29 -43 16 4 170 66 217 93 72 225 107 413 112 159 5 236 -8 349 -57 67 -29 192 -51 171 -31 -15 15 -320 128 -395 147 -82 20 -248 28 -320 15z m96 -27 c-2 -4 -19 -9 -38 -10 -41 -3 -133 -29 -170 -48 -41 -21 -34 -8 10 21 21 14 59 29 83 34 57 11 121 13 115 3z"/><path d="M5316 524 c-18 -18 -6 -54 19 -54 7 0 15 -10 17 -21 5 -35 33 -47 58 -24 29 26 23 59 -12 63 -19 2 -28 9 -28 22 0 10 -7 21 -16 24 -21 8 -20 8 -38 -10z"/><path d="M144 510 c-142 -46 -189 -187 -95 -281 111 -112 282 -20 241 130 -18 68 -67 88 -127 51 -35 -21 -46 -48 -15 -35 9 5 31 10 49 13 39 5 58 -24 50 -76 -12 -68 -74 -99 -139 -68 -44 21 -68 63 -68 119 0 97 115 152 245 116 51 -14 125 -89 144 -147 21 -64 35 -65 28 -3 -19 157 -152 234 -313 181z"/><path d="M2587 523 c-3 -5 -8 -22 -11 -40 -6 -25 -3 -36 13 -52 12 -12 29 -21 40 -21 42 0 59 64 26 100 -18 20 -60 27 -68 13z"/><path d="M4464 519 c-12 -4 -29 -18 -38 -31 -36 -51 -7 -98 62 -98 32 0 45 6 61 26 26 33 26 55 4 83 -21 23 -58 32 -89 20z m81 -49 c0 -16 -63 -62 -79 -57 -24 8 -17 46 11 61 33 19 68 17 68 -4z"/><path d="M3212 508 c-26 -26 -6 -68 33 -68 25 0 48 35 40 61 -7 22 -54 26 -73 7z m45 -34 c-9 -9 -28 6 -21 18 4 6 10 6 17 -1 6 -6 8 -13 4 -17z"/><path d="M1932 429 c-57 -28 -122 -91 -122 -118 0 -17 6 -14 57 26 61 46 144 84 197 90 54 7 95 -12 176 -77 80 -65 136 -91 209 -97 47 -4 61 -1 90 19 49 33 51 49 4 32 -21 -7 -46 -13 -56 -14 -34 0 -129 40 -200 85 -138 88 -252 106 -355 54z"/><path d="M1115 417 c-21 -16 -14 -64 12 -74 42 -16 66 47 27 73 -17 12 -23 12 -39 1z"/><path d="M2487 423 c-10 -9 -8 -35 2 -52 13 -21 51 -4 51 24 0 27 -35 46 -53 28z"/><path d="M5450 399 c-71 -22 -126 -82 -149 -164 -16 -60 -1 -62 31 -4 16 29 38 64 50 76 103 110 373 27 355 -109 -10 -75 -83 -148 -147 -148 -84 0 -152 120 -105 187 19 27 64 43 93 32 35 -13 38 -37 8 -60 -49 -39 -14 -99 38 -66 21 14 26 25 26 58 0 82 -89 126 -170 84 -101 -52 -66 -229 53 -274 98 -37 215 45 233 164 16 108 -93 215 -234 229 -26 3 -63 0 -82 -5z"/><path d="M3938 371 c-32 -11 -79 -33 -105 -49 -119 -76 -209 -102 -268 -78 -43 18 -55 15 -34 -10 21 -25 73 -44 121 -44 53 0 143 41 214 97 70 56 106 73 156 73 51 0 141 -40 211 -94 52 -40 57 -42 57 -23 0 26 -70 95 -122 121 -63 32 -145 34 -230 7z"/><path d="M2055 330 c-56 -21 -77 -97 -34 -121 32 -17 88 -13 110 7 53 48 -8 139 -76 114z m70 -54 c0 -10 -16 -27 -38 -40 -31 -17 -39 -19 -46 -7 -13 20 -3 39 28 56 33 18 56 15 56 -9z"/></g></svg></div>{%- endif -%}

          {%- when 'callout' -%}
            {%- liquid
              assign callout_variant = block.settings.variant | default: 'note'
              assign callout_icon = block.settings.icon | default: 'none'
            -%}
            <div class="mgw__block mgw__callout mgw__callout--{{ callout_variant }}{% if block.settings.left_border %} mgw__callout--bordered{% endif %}" {{ block.shopify_attributes }} {{ motion_attr }}>
              {%- if callout_icon != 'none' -%}
                <div class="mgw__callout__icon">
                  {%- case callout_icon -%}
                    {%- when 'star' -%}<svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    {%- when 'heart' -%}<svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
                    {%- when 'leaf' -%}<svg viewBox="0 0 24 24"><path d="M11 20A7 7 0 019.8 6.9C15.5 4.9 17 3.5 17 3.5s2 2 2 7.5a7 7 0 01-7 9z"/><path d="M11 20V10"/></svg>
                    {%- when 'lightbulb' -%}<svg viewBox="0 0 24 24"><path d="M9 18h6m-5 2h4M12 2a7 7 0 00-3 13.33V17h6v-1.67A7 7 0 0012 2z"/></svg>
                    {%- when 'bell' -%}<svg viewBox="0 0 24 24"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0"/></svg>
                  {%- endcase -%}
                </div>
              {%- endif -%}
              {%- if block.settings.title != blank -%}<h3 class="mgw__callout__title">{{ block.settings.title }}</h3>{%- endif -%}
              {%- if block.settings.body != blank -%}<div class="mgw__callout__body">{{ block.settings.body }}</div>{%- endif -%}
            </div>
